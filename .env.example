# AI QA Framework configuration (pydantic-settings, prefix AIQA_)
# Copy to .env for local overrides. NEVER commit real keys.
# Everything below defaults to the offline MOCK provider: no keys needed in CI.

# --- provider selection -----------------------------------------------------
AIQA_PROVIDER=mock            # mock | gemini | anthropic | openai
AIQA_TIER=critical            # risk tier for thresholds/ (critical | high | standard)

# --- generation parameters (EVL-2: explicit, versioned, recorded per run) ----
AIQA_TEMPERATURE=0.0
AIQA_TOP_P=1.0
AIQA_MAX_TOKENS=1024
AIQA_SEED=42
AIQA_REPEAT_RUNS=5            # N repeats for statistical gates (blueprint: 5..30)

# --- input sanitization (EVL-2) ----------------------------------------------
AIQA_SANITIZE_MAX_CHARS=8000
AIQA_SANITIZE_STRIP_MARKUP=true

# --- run logging --------------------------------------------------------------
AIQA_LOG_DIR=reports

# --- real providers: enabled ONLY via these environment variables -------------
# AIQA_GEMINI_API_KEY=
# AIQA_GEMINI_MODEL=gemini-2.0-flash
# AIQA_ANTHROPIC_API_KEY=
# AIQA_ANTHROPIC_MODEL=claude-sonnet-4-5
# AIQA_OPENAI_API_KEY=
# AIQA_OPENAI_MODEL=gpt-4o-mini
